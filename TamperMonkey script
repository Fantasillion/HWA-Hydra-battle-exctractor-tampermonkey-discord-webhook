            'chaos-hydra-toggle';

        toggleButton.style.display =
            'none';

        document.body.append(
            toggleButton
        );

        // Restore saved webhook
        Promise.resolve(
            GM_getValue(WEBHOOK_KEY, '')
        ).then(value => {
            webhookInput.value =
                value || '';
        }).catch(error => {
            console.warn(
                PREFIX,
                'Could not restore webhook:',
                error
            );
        });

        // Restore saved banners
        loadSavedBanners();

        renderPanel();
    }

