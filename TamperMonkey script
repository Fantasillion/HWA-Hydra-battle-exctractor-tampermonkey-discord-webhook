    function makeButton(text, handler) {
        const button =
            document.createElement('button');

        button.type = 'button';
        button.textContent = text;

        button.addEventListener(
            'click',
            handler
        );

        return button;
    }

    // --------------------------------------------------
    // Create floating panel
    // --------------------------------------------------

    function createPanel() {
        if (
            document.getElementById(
                'chaos-hydra-report-panel'
            )
        ) {
            return;
        }

        addStyles();

        panel =
            document.createElement('section');

        panel.id =
            'chaos-hydra-report-panel';

        const header =
            document.createElement('div');

        header.className =
            'hydra-header';

        const heading =
            document.createElement('strong');

        heading.textContent =
            'ChaosLegion — Hydra Daily Report v1.31';

        const minimize =
            makeButton(
                'Minimize',
                () => {
                    panel.style.display =
                        'none';

                    toggleButton.style.display =
                        'block';
                }
            );

        header.append(
            heading,
            minimize
        );

        panel.append(header);

        // Webhook
        const webhookLabel =
            document.createElement('label');

        webhookLabel.textContent =
            'Discord webhook URL';

        webhookInput =
            document.createElement('input');

        webhookInput.type = 'password';

        webhookInput.placeholder =
            'Paste Discord webhook URL';

        webhookInput.addEventListener(
            'change',
            () =>
                GM_setValue(
                    WEBHOOK_KEY,
                    webhookInput.value.trim()
                )
        );

        panel.append(
            webhookLabel,
            webhookInput
        );

        // Instructions
        const help =
            document.createElement('div');

        help.className =
            'hydra-help';

        help.textContent =
            'Import the five PNG banners once. Minimize this panel and manually open all five Hydra journals to collect current-day data. Attacks are grouped by head and ordered chronologically.';

        panel.append(help);

        // Banner import
        const bannerHeading =
            document.createElement('strong');

        bannerHeading.textContent =
            'Original Hydra banners (one-time setup)';

        const bannerPicker =
            document.createElement('input');

        bannerPicker.type = 'file';

        bannerPicker.accept =
            '.png,image/png';

        bannerPicker.multiple = true;

        bannerPicker.className =
            'hydra-file';

        bannerPicker.addEventListener(
            'change',
            async () => {
                try {
                    await importBanners(
                        Array.from(
                            bannerPicker.files || []
                        )
                    );
                } catch (error) {
                    console.error(
                        PREFIX,
                        'Banner import failed:',
                        error
                    );

                    statusText.textContent =
                        `Banner import error: ${error.message}`;
                }

                // Keep selected filenames visible.
                // Do not clear bannerPicker.value.
            }
        );

        bannerStatus =
            document.createElement('div');

        bannerStatus.className =
            'hydra-status';

        panel.append(
            bannerHeading,
            bannerPicker,
            bannerStatus
        );

        // Journal coverage
        const coverageTitle =
            document.createElement('strong');

        coverageTitle.textContent =
            'Journal coverage';

        coverageArea =
            document.createElement('div');

        coverageArea.className =
            'hydra-coverage';

        statusText =
            document.createElement('div');

        statusText.className =
            'hydra-status';

        panel.append(
            coverageTitle,
            coverageArea,
            statusText
        );

        // Text preview
        const previewLabel =
            document.createElement('label');

        previewLabel.textContent =
            'Text preview (original Hydra banners appear in Discord)';

        previewArea =
            document.createElement('textarea');

        previewArea.readOnly = true;

        panel.append(
            previewLabel,
            previewArea
        );

        // Discord buttons
        englishButton =
            makeButton(
                'Send English to Discord',
                () => sendLanguage('en')
            );

        russianButton =
            makeButton(
                'Send Russian to Discord',
                () => sendLanguage('ru')
            );

        const actions =
            document.createElement('div');

        actions.append(
            englishButton,
            russianButton
        );

        panel.append(actions);

        document.body.append(panel);

        // Minimized toggle
        toggleButton =
            makeButton(
                'Hydra Report 0/5',
                () => {
                    panel.style.display =
                        'block';

                    toggleButton.style.display =
                        'none';
                }
            );

